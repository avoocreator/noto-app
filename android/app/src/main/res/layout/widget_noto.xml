<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Noto 2×2 — kartu DAFTAR tugas yang warnanya mengikuti tema aplikasi.
  Latar (gradien + garis tepi), daftar tugas (lingkaran centang + judul),
  progress bar, dan tombol "+" digambar secara dinamis sebagai bitmap oleh
  NotoWidgetProvider dari tema & data yang dikirim aplikasi; layout ini hanya
  kerangka posisinya. Jumlah baris daftar mengikuti ukuran widget — makin
  tinggi widget (2×3, 2×4, …) makin banyak tugas tampil.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Latar kartu: bitmap gradien membulat warna tema -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <!-- Konten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="9dp">

        <!-- Baris atas: brand + jumlah aktif + tombol refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Noto"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:textColor="#F97316" />

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0 AKTIF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#EDEDF0" />

            <!-- Spacer (TextView = tipe aman untuk RemoteViews) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟳"
                android:textSize="12sp"
                android:textColor="#9C9CA8"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Daftar tugas: bitmap baris (lingkaran centang + judul).
             Tinggi fleksibel — bitmap digambar mengikuti ruang yang tersisa. -->
        <ImageView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:scaleType="fitXY"
            android:contentDescription="Daftar tugas" />

        <!-- Bawah: progress bar + rasio selesai + tombol tambah cepat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_progress"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="6dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:id="@+id/widget_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#9C9CA8" />

            <TextView
                android:layout_width="8dp"
                android:layout_height="1dp"
                android:text="" />

            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitXY"
                android:contentDescription="Tambah tugas" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
