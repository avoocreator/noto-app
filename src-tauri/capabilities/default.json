{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin untuk jendela utama dan jendela widget",
  "windows": ["main", "widget"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "fs:default",
    "fs:allow-read-file", "fs:allow-write-file", "fs:allow-read-dir", "fs:allow-mkdir",
    "fs:allow-remove", "fs:allow-rename", "fs:allow-exists", "fs:allow-stat", "fs:allow-copy-file",
    { "identifier": "fs:scope", "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$APPDATA/**" }] }
  ]
}
