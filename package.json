{
  "name": "noto",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Noto — vault catatan Markdown + canvas, lokal-first, sinkron opsional via Supabase.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "brand": "python3 scripts/make-brand.py",
    "cap:add": "cap add android",
    "cap:sync": "vite build && cap sync android && node scripts/apply-android-widget.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.3.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "motion": "^12.23.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@types/node": "^22.0.0"
  }
}